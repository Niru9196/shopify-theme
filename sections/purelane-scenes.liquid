{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-scenes.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign enable_water = section.settings.enable_water
  assign enable_bubbles = section.settings.enable_bubbles
  assign bubble_count = section.settings.bubble_count
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<purelane-scenes
  class="pl-scenes purelane-section"
  id="pl-scenes"
  data-d="1"
  data-enable-water="{{ enable_water }}"
  aria-hidden="true"
>
  {%- comment %} Scene gradient layers — crossfade driven by scroll position {% endcomment -%}
  <div class="pl-scene pl-s1 pl-on"></div>
  <div class="pl-scene pl-s2"></div>
  <div class="pl-scene pl-s3"></div>
  <div class="pl-scene pl-s4"></div>

  {%- if enable_water -%}
    <div class="pl-water" id="pl-water">
      {%- comment %} Layer A: main caustic lines {% endcomment -%}
      <div class="pl-wl pl-wl-a">
        <svg class="pl-sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="plcg" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#eafff4" stop-opacity="0"/>
              <stop offset=".18" stop-color="#f2fff8" stop-opacity=".95"/>
              <stop offset=".5" stop-color="#ffffff" stop-opacity="1"/>
              <stop offset=".82" stop-color="#e6fbef" stop-opacity=".9"/>
              <stop offset="1" stop-color="#eafff4" stop-opacity="0"/>
            </linearGradient>
            <filter id="plwf" x="-12%" y="-12%" width="124%" height="124%" color-interpolation-filters="sRGB">
              <feTurbulence type="fractalNoise" baseFrequency="0.0022 0.019" numOctaves="3" seed="21" result="n"/>
              <feDisplacementMap in="SourceGraphic" in2="n" scale="72" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
          </defs>
          <g filter="url(#plwf)">
            <path d="M262 230 Q372 261 482 238 Q592 247 702 250 Q812 210 923 235 Q1033 201 1143 213 Q1253 232 1363 215 Q1473 261 1583 238 Q1694 248 1804 250" stroke="url(#plcg)" stroke-width="1.7" fill="none" opacity="0.45" stroke-linecap="round"/>
            <path d="M137 256 Q307 242 477 258 Q646 238 816 245 Q985 259 1155 247 Q1324 277 1494 262 Q1664 267 1833 269" stroke="url(#plcg)" stroke-width="5.1" fill="none" opacity="0.23" stroke-linecap="round"/>
            <path d="M389 715 Q514 756 639 725 Q763 738 888 742 Q1013 688 1138 721 Q1262 674 1387 692 Q1512 716 1636 694 Q1761 756 1886 724" stroke="url(#plcg)" stroke-width="5.7" fill="none" opacity="0.37" stroke-linecap="round"/>
            <path d="M140 308 Q297 310 454 302 Q611 321 769 312 Q926 314 1083 316 Q1240 298 1397 309 Q1555 295 1712 300 Q1869 309 2026 301" stroke="url(#plcg)" stroke-width="5.5" fill="none" opacity="0.47" stroke-linecap="round"/>
            <path d="M570 422 Q687 462 805 437 Q922 436 1039 446 Q1156 391 1274 423 Q1391 388 1508 398 Q1625 432 1742 406 Q1860 462 1977 436" stroke="url(#plcg)" stroke-width="2.3" fill="none" opacity="0.25" stroke-linecap="round"/>
            <path d="M-20 1118 Q114 1112 249 1129 Q384 1090 518 1109 Q653 1106 787 1101 Q922 1138 1056 1116 Q1191 1142 1325 1134 Q1460 1113 1594 1130" stroke="url(#plcg)" stroke-width="3.5" fill="none" opacity="0.37" stroke-linecap="round"/>
            <path d="M564 653 Q704 686 843 651 Q983 691 1123 679 Q1263 644 1403 671 Q1542 609 1682 638 Q1822 634 1962 626" stroke="url(#plcg)" stroke-width="5.2" fill="none" opacity="0.23" stroke-linecap="round"/>
            <path d="M229 990 Q390 1026 551 1018 Q712 974 873 1006 Q1034 944 1195 972 Q1356 977 1517 963 Q1678 1028 1839 991" stroke="url(#plcg)" stroke-width="6.1" fill="none" opacity="0.36" stroke-linecap="round"/>
            <path d="M51 390 Q154 420 258 394 Q361 414 465 411 Q568 376 672 400 Q776 357 879 376 Q983 384 1086 371 Q1190 419 1293 393 Q1397 415 1500 411 Q1604 377 1707 401" stroke="url(#plcg)" stroke-width="4.7" fill="none" opacity="0.42" stroke-linecap="round"/>
            <path d="M108 333 Q262 355 416 346 Q570 331 724 344 Q879 309 1033 327 Q1187 320 1341 318 Q1495 348 1650 329 Q1804 355 1958 346" stroke="url(#plcg)" stroke-width="3.4" fill="none" opacity="0.39" stroke-linecap="round"/>
            <path d="M-188 1020 Q-91 1044 5 1036 Q102 1013 198 1031 Q294 991 391 1010 Q487 1008 583 1002 Q680 1040 776 1018 Q873 1044 969 1036 Q1065 1014 1162 1031" stroke="url(#plcg)" stroke-width="6.0" fill="none" opacity="0.45" stroke-linecap="round"/>
            <path d="M297 164 Q449 165 600 176 Q752 143 904 160 Q1055 150 1207 150 Q1359 176 1510 159 Q1662 186 1814 175 Q1966 166 2117 176" stroke="url(#plcg)" stroke-width="2.3" fill="none" opacity="0.27" stroke-linecap="round"/>
            <path d="M28 705 Q167 686 307 687 Q446 720 586 698 Q726 734 865 719 Q1005 709 1144 721 Q1284 679 1423 702 Q1563 685 1702 687 Q1842 719 1981 698" stroke="url(#plcg)" stroke-width="1.7" fill="none" opacity="0.20" stroke-linecap="round"/>
            <path d="M124 765 Q223 775 322 791 Q421 725 520 761 Q619 730 718 736 Q816 782 915 750 Q1014 811 1113 784 Q1212 776 1311 792 Q1410 726 1508 762" stroke="url(#plcg)" stroke-width="3.6" fill="none" opacity="0.28" stroke-linecap="round"/>
            <path d="M17 445 Q151 447 284 423 Q417 488 550 455 Q683 470 816 473 Q950 417 1083 452 Q1216 402 1349 421 Q1482 445 1615 422" stroke="url(#plcg)" stroke-width="4.2" fill="none" opacity="0.43" stroke-linecap="round"/>
            <path d="M183 850 Q321 853 459 872 Q597 811 735 843 Q873 822 1011 823 Q1149 870 1287 839 Q1425 890 1563 870 Q1701 854 1838 872" stroke="url(#plcg)" stroke-width="2.8" fill="none" opacity="0.20" stroke-linecap="round"/>
          </g>
        </svg>
      </div>

      {%- comment %} Layer B: secondary softer caustics {% endcomment -%}
      <div class="pl-wl pl-wl-b">
        <svg class="pl-sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="plcg2" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#eafff4" stop-opacity="0"/>
              <stop offset=".18" stop-color="#f2fff8" stop-opacity=".95"/>
              <stop offset=".5" stop-color="#ffffff" stop-opacity="1"/>
              <stop offset=".82" stop-color="#e6fbef" stop-opacity=".9"/>
              <stop offset="1" stop-color="#eafff4" stop-opacity="0"/>
            </linearGradient>
            <filter id="plwf2" x="-12%" y="-12%" width="124%" height="124%" color-interpolation-filters="sRGB">
              <feTurbulence type="fractalNoise" baseFrequency="0.005 0.031" numOctaves="2" seed="47" result="n"/>
              <feDisplacementMap in="SourceGraphic" in2="n" scale="46" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
          </defs>
          <g filter="url(#plwf2)">
            <path d="M355 217 Q442 234 529 234 Q616 202 703 222 Q790 190 877 203 Q964 215 1051 202 Q1138 242 1225 221 Q1312 235 1399 234" stroke="url(#plcg2)" stroke-width="3.4" fill="none" opacity="0.17" stroke-linecap="round"/>
            <path d="M160 723 Q278 720 396 713 Q514 738 633 725 Q751 735 869 734 Q987 715 1105 728 Q1223 706 1341 715 Q1459 720 1577 713" stroke="url(#plcg2)" stroke-width="1.1" fill="none" opacity="0.17" stroke-linecap="round"/>
            <path d="M315 17 Q425 -1 536 5 Q647 22 758 9 Q869 37 980 24 Q1090 25 1201 30 Q1312 2 1423 18 Q1534 -1 1645 5" stroke="url(#plcg2)" stroke-width="2.1" fill="none" opacity="0.26" stroke-linecap="round"/>
            <path d="M583 59 Q725 41 867 59 Q1009 41 1150 46 Q1292 65 1434 51 Q1575 81 1717 67 Q1859 67 2001 72" stroke="url(#plcg2)" stroke-width="1.4" fill="none" opacity="0.15" stroke-linecap="round"/>
            <path d="M540 585 Q622 570 704 574 Q785 590 867 578 Q949 603 1031 592 Q1112 591 1194 596 Q1276 571 1358 585 Q1440 570 1521 574" stroke="url(#plcg2)" stroke-width="1.4" fill="none" opacity="0.17" stroke-linecap="round"/>
            <path d="M167 54 Q314 77 461 71 Q608 46 755 64 Q901 26 1048 44 Q1195 44 1342 37 Q1488 75 1635 53 Q1782 77 1929 70" stroke="url(#plcg2)" stroke-width="1.5" fill="none" opacity="0.24" stroke-linecap="round"/>
            <path d="M270 848 Q346 834 422 834 Q497 859 573 843 Q648 868 724 858 Q800 850 875 859 Q951 828 1027 844 Q1102 833 1178 834 Q1254 858 1329 842" stroke="url(#plcg2)" stroke-width="3.2" fill="none" opacity="0.34" stroke-linecap="round"/>
            <path d="M-25 703 Q125 726 274 719 Q423 696 573 713 Q722 675 872 693 Q1021 692 1170 686 Q1320 723 1469 702 Q1619 726 1768 719" stroke="url(#plcg2)" stroke-width="1.8" fill="none" opacity="0.33" stroke-linecap="round"/>
            <path d="M270 973 Q373 961 475 965 Q578 976 681 967 Q783 988 886 978 Q988 980 1091 982 Q1193 963 1296 975 Q1399 961 1501 965" stroke="url(#plcg2)" stroke-width="3.2" fill="none" opacity="0.28" stroke-linecap="round"/>
            <path d="M-181 317 Q-61 299 59 317 Q180 299 300 304 Q420 323 540 308 Q660 339 781 325 Q901 325 1021 330 Q1141 300 1261 317 Q1382 298 1502 304" stroke="url(#plcg2)" stroke-width="3.3" fill="none" opacity="0.24" stroke-linecap="round"/>
          </g>
        </svg>
      </div>

      {%- comment %} Layer C: light shafts {% endcomment -%}
      <div class="pl-wl pl-wl-c">
        <svg class="pl-sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="plsg" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#f4fff9" stop-opacity=".85"/>
              <stop offset=".38" stop-color="#dcf6e7" stop-opacity=".28"/>
              <stop offset="1" stop-color="#d4f2e2" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <g>
            <polygon points="95,-80 152,-80 517,1180 439,1180" fill="url(#plsg)" opacity="0.26"/>
            <polygon points="433,-80 491,-80 885,1180 807,1180" fill="url(#plsg)" opacity="0.41"/>
            <polygon points="751,-80 919,-80 1180,1180 953,1180" fill="url(#plsg)" opacity="0.31"/>
            <polygon points="1048,-80 1135,-80 1400,1180 1282,1180" fill="url(#plsg)" opacity="0.28"/>
            <polygon points="1366,-80 1520,-80 1898,1180 1690,1180" fill="url(#plsg)" opacity="0.28"/>
            <polygon points="1695,-80 1808,-80 2067,1180 1914,1180" fill="url(#plsg)" opacity="0.35"/>
            <polygon points="1948,-80 2013,-80 2341,1180 2254,1180" fill="url(#plsg)" opacity="0.32"/>
          </g>
        </svg>
      </div>

      {%- comment %} Layer S: surface shimmer {% endcomment -%}
      <div class="pl-wl pl-wl-s">
        <svg class="pl-sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="plsf" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#ffffff" stop-opacity=".55"/>
              <stop offset=".55" stop-color="#e8fff2" stop-opacity=".16"/>
              <stop offset="1" stop-color="#e8fff2" stop-opacity="0"/>
            </linearGradient>
            <filter id="plsfw" x="-10%" y="-40%" width="120%" height="180%" color-interpolation-filters="sRGB">
              <feTurbulence type="fractalNoise" baseFrequency="0.004 0.05" numOctaves="2" seed="9" result="n"/>
              <feDisplacementMap in="SourceGraphic" in2="n" scale="30" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
          </defs>
          <g filter="url(#plsfw)">
            <rect x="-100" y="-40" width="2000" height="150" fill="url(#plsf)"/>
            <rect x="-100" y="60" width="2000" height="60" fill="url(#plsf)" opacity=".5"/>
          </g>
        </svg>
      </div>

      {%- comment %} Bubbles {% endcomment -%}
      {%- if enable_bubbles -%}
        <div class="pl-bub">
          {%- for i in (1..bubble_count) -%}
            {%- assign x_rand = i | times: 7 | modulo: 100 -%}
            {%- assign size_rand = i | times: 3 | modulo: 7 | plus: 3 -%}
            {%- assign dur_rand = i | times: 5 | modulo: 15 | plus: 13 -%}
            {%- assign dly_rand = i | times: 4 | modulo: 20 -%}
            {%- assign drift_rand = i | times: 11 | modulo: 80 | minus: 40 -%}
            <span style="--x:{{ x_rand }}%;--s:{{ size_rand }}px;--dur:{{ dur_rand }}s;--dly:{{ dly_rand }}s;--drift:{{ drift_rand }}px"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="pl-vig"></div>
</purelane-scenes>

<script src="{{ 'purelane-scenes.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Purelane Scenes",
  "tag": "section",
  "class": "purelane-scenes-section",
  "settings": [
    {
      "type": "header",
      "content": "Background Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_water",
      "label": "Enable water animation",
      "default": true,
      "info": "Animated underwater caustic lines and light shafts."
    },
    {
      "type": "checkbox",
      "id": "enable_bubbles",
      "label": "Enable bubbles",
      "default": true,
      "info": "Slowly rising bubbles. Disabled on mobile for performance."
    },
    {
      "type": "range",
      "id": "bubble_count",
      "label": "Bubble count",
      "min": 4,
      "max": 20,
      "step": 2,
      "default": 12,
      "info": "More bubbles may affect performance on older devices."
    }
  ],
  "presets": [
    {
      "name": "Purelane Scenes"
    }
  ]
}
{% endschema %}
