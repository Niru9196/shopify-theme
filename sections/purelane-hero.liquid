{{ 'purelane-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign heading_accent = section.settings.heading_accent
  assign subheading = section.settings.subheading
  assign cta_text = section.settings.cta_text
  assign cta_url = section.settings.cta_url
  assign cta2_text = section.settings.cta2_text
  assign cta2_url = section.settings.cta2_url
  assign slides = section.blocks | where: 'type', 'slide'
  assign badges = section.blocks | where: 'type', 'badge'
-%}

<section class="pl-hero purelane-section" data-scene="1" id="pl-hero">
  <div class="pl-hero__grid">

    {%- comment %} Desktop badge rail {% endcomment -%}
    {%- if badges.size > 0 -%}
      <div class="pl-badges pl-glass-2" aria-label="{{ 'sections.purelane_hero.badges_label' | t | default: 'Product promises' }}">
        {%- for block in badges -%}
          <div class="pl-badge" {{ block.shopify_attributes }}>
            <span class="pl-badge__icon">
              {%- case block.settings.icon -%}
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                {%- when 'no-chemicals' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
                {%- when 'heart' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
                {%- when 'globe' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2M12 3.4c2.4 2.4 3.6 5.4 3.6 8.6S14.4 18.2 12 20.6c-2.4-2.4-3.6-5.4-3.6-8.6S9.6 5.8 12 3.4Z"/></svg>
              {%- endcase -%}
            </span>
            <span>{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment %} Hero copy {% endcomment -%}
    <div class="pl-hero__copy">
      <h1 class="pl-d1 pl-rv pl-in">
        {{ heading }}
        {%- if heading_accent != blank -%}
          <br><span class="pl-lime">{{ heading_accent }}</span>
        {%- endif -%}
      </h1>

      <div class="pl-rule pl-rv pl-rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>

      {%- if subheading != blank -%}
        <p class="pl-lede pl-rv pl-rv-d2">{{ subheading }}</p>
      {%- endif -%}

      <div class="pl-hero__cta pl-rv pl-rv-d3">
        {%- if cta_text != blank -%}
          <a class="pl-btn pl-btn-primary" href="{{ cta_url }}">
            {{ cta_text }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        {%- endif -%}
        {%- if cta2_text != blank -%}
          <a class="pl-btn pl-btn-ghost" href="{{ cta2_url }}">{{ cta2_text }}</a>
        {%- endif -%}
      </div>

      {%- comment %} Mobile badge strip {% endcomment -%}
      {%- if badges.size > 0 -%}
        <div class="pl-badgestrip pl-rv pl-rv-d4">
          {%- for block in badges -%}
            <div class="pl-badgestrip__item pl-glass-2">
              {%- case block.settings.icon -%}
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                {%- when 'no-chemicals' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
                {%- when 'heart' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
                {%- when 'globe' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2M12 3.4c2.4 2.4 3.6 5.4 3.6 8.6S14.4 18.2 12 20.6c-2.4-2.4-3.6-5.4-3.6-8.6S9.6 5.8 12 3.4Z"/></svg>
              {%- endcase -%}
              {{ block.settings.label_short | default: block.settings.label }}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment %} Product slideshow {% endcomment -%}
    {%- if slides.size > 0 -%}
      <div class="pl-hero__prod">
        <purelane-hero-stage class="pl-hstage" data-interval="{{ section.settings.slide_interval }}">
          {%- for block in slides -%}
            {%- assign slide_class = 'pl-hslide' -%}
            {%- case block.settings.product_count -%}
              {%- when 1 -%}{%- assign slide_class = slide_class | append: ' pl-hs1' -%}
              {%- when 2 -%}{%- assign slide_class = slide_class | append: ' pl-hs2' -%}
              {%- when 3 -%}{%- assign slide_class = slide_class | append: ' pl-hs3' -%}
            {%- endcase -%}
            {%- if forloop.first -%}{%- assign slide_class = slide_class | append: ' pl-on' -%}{%- endif -%}

            <div class="{{ slide_class }}" data-n="{{ forloop.index }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image_a != blank -%}
                <img
                  class="pl-hp pl-hp-a pl-d1"
                  src="{{ block.settings.image_a | image_url: width: 560 }}"
                  alt="{{ block.settings.image_a.alt | escape }}"
                  width="280"
                  height="auto"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                >
              {%- endif -%}
              {%- if block.settings.image_b != blank -%}
                <img
                  class="pl-hp pl-hp-b pl-d2"
                  src="{{ block.settings.image_b | image_url: width: 560 }}"
                  alt="{{ block.settings.image_b.alt | escape }}"
                  width="280"
                  height="auto"
                  loading="lazy"
                >
              {%- endif -%}
              {%- if block.settings.image_c != blank -%}
                <img
                  class="pl-hp pl-hp-c pl-d3"
                  src="{{ block.settings.image_c | image_url: width: 560 }}"
                  alt="{{ block.settings.image_c.alt | escape }}"
                  width="280"
                  height="auto"
                  loading="lazy"
                >
              {%- endif -%}

              {%- if block.settings.price != blank -%}
                <div class="pl-glass-2 pl-ptag">
                  <span class="pl-ptag__lbl">{{ block.settings.price_label }}</span>
                  <span class="pl-ptag__val">
                    <strong>{{ block.settings.price }}</strong>
                    {%- if block.settings.compare_price != blank -%}
                      <s>{{ block.settings.compare_price }}</s>
                    {%- endif -%}
                  </span>
                  {%- if block.settings.savings_badge != blank -%}
                    <span class="pl-ptag__cut">{{ block.settings.savings_badge }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}

          <div class="pl-hdots">
            {%- for block in slides -%}
              <button type="button" class="{% if forloop.first %}pl-on{% endif %}" aria-label="Show slide {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        </purelane-hero-stage>
      </div>
    {%- endif -%}

  </div>
</section>

<script src="{{ 'purelane-hero-stage.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "purelane-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean<br>That"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Accent word (coloured)",
      "default": "Lasts"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Primary button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta2_text",
      "label": "Secondary button text",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "range",
      "id": "slide_interval",
      "label": "Auto-advance interval (ms)",
      "min": 2000,
      "max": 8000,
      "step": 200,
      "default": 3800
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Product slide",
      "settings": [
        {
          "type": "range",
          "id": "product_count",
          "label": "Products in slide",
          "min": 1,
          "max": 3,
          "step": 1,
          "default": 1
        },
        {
          "type": "image_picker",
          "id": "image_a",
          "label": "Product image A"
        },
        {
          "type": "image_picker",
          "id": "image_b",
          "label": "Product image B (2+ products)"
        },
        {
          "type": "image_picker",
          "id": "image_c",
          "label": "Product image C (3 products)"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Price label",
          "default": "Single bottle"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹200"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare-at price",
          "default": "₹299"
        },
        {
          "type": "text",
          "id": "savings_badge",
          "label": "Savings badge text",
          "default": "33% off"
        }
      ]
    },
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf (plant)" },
            { "value": "shield", "label": "Shield (safe)" },
            { "value": "no-chemicals", "label": "No chemicals" },
            { "value": "heart", "label": "Heart" },
            { "value": "globe", "label": "Globe" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (desktop)",
          "default": "Plant powered"
        },
        {
          "type": "text",
          "id": "label_short",
          "label": "Short label (mobile)",
          "default": "Plant powered"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "product_count": 1,
            "price_label": "Single bottle",
            "price": "₹200",
            "compare_price": "₹299",
            "savings_badge": "33% off"
          }
        },
        {
          "type": "slide",
          "settings": {
            "product_count": 2,
            "price_label": "Any 2 products",
            "price": "₹349",
            "compare_price": "₹598",
            "savings_badge": "Save ₹249"
          }
        },
        {
          "type": "slide",
          "settings": {
            "product_count": 3,
            "price_label": "Any 3 products",
            "price": "₹499",
            "compare_price": "₹897",
            "savings_badge": "Save ₹398"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "leaf",
            "label": "Plant<br>powered",
            "label_short": "Plant powered"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "shield",
            "label": "Safe for<br>kids & pets",
            "label_short": "Kids & pet safe"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "no-chemicals",
            "label": "Zero harsh<br>chemicals",
            "label_short": "Zero harsh chem"
          }
        }
      ]
    }
  ]
}
{% endschema %}
