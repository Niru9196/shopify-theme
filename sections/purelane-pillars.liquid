{%- liquid
  assign pillars = section.blocks
-%}

{%- if pillars.size > 0 -%}
<section class="pl-sec purelane-section" id="pl-how" data-scene="2">
  <div class="pl-wrap">
    <div class="pl-pillars">
      {%- for block in pillars -%}
        <article class="pl-glass pl-pillar pl-rv{% if forloop.index > 1 %} pl-rv-d{{ forloop.index }}{% endif %}" {{ block.shopify_attributes }}>
          <span class="pl-pillar__icon">
            {%- case block.settings.icon -%}
              {%- when 'bubbles' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8.5" r="3.2"/><circle cx="16.4" cy="6.6" r="2.2"/><circle cx="15" cy="13" r="2.8"/><circle cx="8.6" cy="15.6" r="2.1"/><path d="M4 21h16"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
              {%- when 'heart' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
              {%- when 'star' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8Z"/></svg>
            {%- endcase -%}
          </span>
          <h3 class="pl-d3">{{ block.settings.heading }}</h3>
          <p class="pl-body-s">{{ block.settings.body }}</p>
          {%- if block.settings.link_text != blank -%}
            <a class="pl-btn pl-btn-ghost pl-btn-sm" href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

<style>
  .pl-pillars {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 820px) {
    .pl-pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pl-pillar {
    padding: 26px 24px 24px;
    display: flex;
    flex-direction: column;
  }

  .pl-pillar__icon {
    width: 50px;
    height: 50px;
    border-radius: 15px;
    display: grid;
    place-items: center;
    margin-bottom: 16px;
    background: linear-gradient(150deg, rgba(201, 118, 29, 0.18), rgba(75, 58, 143, 0.12));
    border: 1px solid rgba(75, 58, 143, 0.16);
    color: var(--pl-green);
  }

  .pl-pillar__icon svg {
    width: 24px;
    height: 24px;
  }

  .pl-pillar .pl-d3 {
    margin-bottom: 11px;
  }

  .pl-pillar p {
    margin-bottom: 20px;
    flex: 1;
  }

  .pl-pillar .pl-btn {
    align-self: flex-start;
  }
</style>

{% schema %}
{
  "name": "Purelane Pillars",
  "tag": "section",
  "class": "purelane-pillars-section",
  "settings": [],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "bubbles", "label": "Bubbles (cleaning)" },
            { "value": "shield", "label": "Shield (safe)" },
            { "value": "heart", "label": "Heart (gentle)" },
            { "value": "leaf", "label": "Leaf (natural)" },
            { "value": "star", "label": "Star" }
          ],
          "default": "bubbles"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Less scrubbing"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text",
          "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Button text",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon": "bubbles",
            "heading": "Less scrubbing",
            "body": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub.",
            "link_text": "Learn more"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "shield",
            "heading": "Clean ingredients",
            "body": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food.",
            "link_text": "Learn more"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "heart",
            "heading": "Safe around everyone",
            "body": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day.",
            "link_text": "Learn more"
          }
        }
      ]
    }
  ]
}
{% endschema %}
