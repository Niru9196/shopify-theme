{%- liquid
  assign kicker = section.settings.kicker
  assign heading = section.settings.heading
  assign benefits = section.blocks
-%}

<section class="pl-sec purelane-section" id="pl-whybundles" data-scene="4">
  <div class="pl-wrap">
    <div class="pl-glass pl-sec-pad pl-rv">
      <div class="pl-panel-head">
        {%- if kicker != blank -%}<span class="pl-kicker">{{ kicker }}</span>{%- endif -%}
        <h2 class="pl-d2" style="margin-top:12px">{{ heading }}</h2>
      </div>
      {%- if benefits.size > 0 -%}
        <div class="pl-wb">
          {%- for block in benefits -%}
            <div class="pl-wb__item" {{ block.shopify_attributes }}>
              <span class="pl-wb__icon">
                {%- case block.settings.icon -%}
                  {%- when 'money' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M16.5 7.2C15.6 6 14 5.4 12 5.4c-2.4 0-4 1.1-4 2.9 0 2 1.7 2.7 4.2 3.3 2.7.6 4.3 1.4 4.3 3.4 0 1.9-1.7 3.1-4.5 3.1-2.2 0-3.8-.7-4.8-2"/></svg>
                  {%- when 'checkbox' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3.4"/><path d="m8.4 12.2 2.4 2.4 4.8-5"/></svg>
                  {%- when 'star' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.6 9.7l5.8-.8Z"/></svg>
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.6 16.4V7.2h10.2v9.2"/><path d="M12.8 10.4h4l3.6 3.2v2.8h-7.6"/><circle cx="6.6" cy="18" r="1.9"/><circle cx="16.6" cy="18" r="1.9"/></svg>
                {%- endcase -%}
              </span>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.description }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .pl-wb { display: grid; gap: 20px 16px; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 880px) { .pl-wb { grid-template-columns: repeat(4, 1fr); } }

  .pl-wb__item { text-align: center; }
  .pl-wb__icon {
    width: 56px; height: 56px; margin: 0 auto 14px; border-radius: 50%; display: grid; place-items: center;
    background: radial-gradient(circle at 36% 28%, rgba(201,118,29,.20), rgba(75,58,143,.12));
    border: 1px solid rgba(75,58,143,.16); color: var(--pl-green);
  }
  .pl-wb__icon svg { width: 25px; height: 25px; }
  .pl-wb__item h4 {
    font-family: 'Outfit', sans-serif; font-size: 13.5px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.03em; color: var(--pl-surface); margin-bottom: 7px;
  }
  .pl-wb__item p { font-size: 12.2px; color: var(--pl-paper-2); line-height: 1.5; }
</style>

{% schema %}
{
  "name": "Purelane Why Bundles",
  "tag": "section",
  "class": "purelane-why-bundles-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The smarter way to shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why bundles beat buying single" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "money", "label": "Money (savings)" },
          { "value": "checkbox", "label": "Checkbox (flat price)" },
          { "value": "star", "label": "Star (curated)" },
          { "value": "truck", "label": "Truck (shipping)" }
        ], "default": "money" },
        { "type": "text", "id": "title", "label": "Title", "default": "Save up to 45%" },
        { "type": "text", "id": "description", "label": "Description", "default": "Versus buying the same products separately" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Why Bundles",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "money", "title": "Save up to 45%", "description": "Versus buying the same products separately" } },
        { "type": "benefit", "settings": { "icon": "checkbox", "title": "One flat price", "description": "No calculators, no comparing carts" } },
        { "type": "benefit", "settings": { "icon": "star", "title": "Curated by experts", "description": "Products picked to work well together" } },
        { "type": "benefit", "settings": { "icon": "truck", "title": "Free shipping always", "description": "Included on every bundle, all India" } }
      ]
    }
  ]
}
{% endschema %}
