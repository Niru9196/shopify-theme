{%- liquid
  assign kicker = section.settings.kicker
  assign heading = section.settings.heading
  assign subtitle = section.settings.subtitle
  assign tiers = section.blocks
-%}

<section class="pl-sec purelane-section" id="pl-bundles" data-scene="3">
  <div class="pl-wrap">
    <div class="pl-glass pl-sec-pad pl-rv" style="margin-bottom:16px">
      <div class="pl-panel-head" style="margin-bottom:0">
        {%- if kicker != blank -%}<span class="pl-kicker">{{ kicker }}</span>{%- endif -%}
        <h2 class="pl-d2" style="margin-top:12px">{{ heading }}</h2>
        {%- if subtitle != blank -%}<p class="pl-lede" style="margin:0 auto">{{ subtitle }}</p>{%- endif -%}
      </div>
    </div>

    {%- if tiers.size > 0 -%}
      <div class="pl-tiers">
        {%- for block in tiers -%}
          <article class="pl-glass pl-tier{% if block.settings.popular %} pl-tier--best{% endif %} pl-rv{% if forloop.index > 1 %} pl-rv-d{{ forloop.index }}{% endif %}" {{ block.shopify_attributes }}>
            <span class="pl-tier__tag">{{ block.settings.tag }}</span>
            <div class="pl-tier__qty">{{ block.settings.quantity }}<small>Products</small></div>
            <div class="pl-tier__price">{{ block.settings.price }} <s>{{ block.settings.compare_price }}</s></div>
            <p class="pl-body-s" style="font-size:12px">{{ block.settings.per_unit }}</p>
            <ul class="pl-tier__list">
              {%- assign features = block.settings.features | split: '|' -%}
              {%- for feat in features -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                  {{ feat }}
                </li>
              {%- endfor -%}
            </ul>
            <a class="pl-btn {% if block.settings.popular %}pl-btn-primary{% else %}pl-btn-ghost{% endif %}" href="{{ block.settings.link }}">
              {{ block.settings.cta_text }}
              {%- if block.settings.popular -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              {%- endif -%}
            </a>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .pl-tiers { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .pl-tiers { grid-template-columns: repeat(3, 1fr); } }

  .pl-tier { padding: 24px 22px; transition: 0.4s var(--pl-ease); }
  .pl-tier:hover { transform: translateY(-5px); }
  .pl-tier--best {
    border-color: rgba(201,118,29,.46);
    box-shadow: 0 22px 54px rgba(58,44,112,.14), 0 0 0 1px rgba(201,118,29,.24), var(--pl-g-inset);
  }

  .pl-tier__tag {
    display: inline-block;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 999px;
    margin-bottom: 14px;
    background: rgba(201,118,29,.14);
    border: 1px solid rgba(201,118,29,.34);
    color: var(--pl-green);
  }

  .pl-tier__qty {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 52px;
    line-height: 0.9;
    color: var(--pl-surface);
    letter-spacing: -0.03em;
  }
  .pl-tier__qty small {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pl-paper-3);
    display: block;
    margin-top: 6px;
  }

  .pl-tier__price {
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 27px;
    color: var(--pl-accent);
    margin: 16px 0 4px;
  }
  .pl-tier__price s { font-size: 14px; color: var(--pl-paper-3); font-weight: 500; margin-left: 8px; }

  .pl-tier__list {
    list-style: none;
    margin: 16px 0 20px;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .pl-tier__list li {
    display: flex;
    gap: 9px;
    font-size: 13px;
    color: var(--pl-paper-2);
  }
  .pl-tier__list li svg { width: 14px; height: 14px; color: var(--pl-green); flex: 0 0 auto; margin-top: 4px; }

  .pl-tier .pl-btn { width: 100%; justify-content: center; }

  @media (max-width: 760px) { .pl-tier__qty { font-size: 44px; } }
</style>

{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "purelane-bundles-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag label", "default": "Starter" },
        { "type": "checkbox", "id": "popular", "label": "Highlight as popular", "default": false },
        { "type": "text", "id": "quantity", "label": "Quantity number", "default": "2" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹349" },
        { "type": "text", "id": "compare_price", "label": "Compare price", "default": "₹598" },
        { "type": "text", "id": "per_unit", "label": "Per-unit note", "default": "Flat ₹174 per product" },
        { "type": "textarea", "id": "features", "label": "Features (pipe-separated)", "default": "Pick any two products|Free shipping across India" },
        { "type": "text", "id": "cta_text", "label": "Button text", "default": "Build this box" },
        { "type": "url", "id": "link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        { "type": "tier", "settings": { "tag": "Starter", "popular": false, "quantity": "2", "price": "₹349", "compare_price": "₹598", "per_unit": "Flat ₹174 per product", "features": "Pick any two products|Free shipping across India", "cta_text": "Build this box" } },
        { "type": "tier", "settings": { "tag": "Most popular", "popular": true, "quantity": "3", "price": "₹499", "compare_price": "₹897", "per_unit": "Flat ₹166 per product", "features": "Pick any three products|Covers kitchen and laundry|Free shipping across India", "cta_text": "Build this box" } },
        { "type": "tier", "settings": { "tag": "Whole home", "popular": false, "quantity": "5", "price": "₹799", "compare_price": "₹1495", "per_unit": "Flat ₹160 per product", "features": "Pick any five products|Every room in one order|Free shipping across India", "cta_text": "Build this box" } }
      ]
    }
  ]
}
{% endschema %}
